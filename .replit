modules = ["nodejs-20", "web", "javascript", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["chromium"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5070
externalPort = 3001

[[ports]]
localPort = 5071
externalPort = 3000

[[ports]]
localPort = 5072
externalPort = 3002

[[ports]]
localPort = 5073
externalPort = 3003

[env]
PORT = "5000"

[deployment]
deploymentTarget = "vm"
build = ["npm", "run", "build"]
run = ["node", "./dist/index.cjs"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test"

[agent]
mockupState = "FULLSTACK"
integrations = ["javascript_anthropic_ai_integrations:2.0.0", "javascript_object_storage:2.0.0", "sendgrid:1.0.0", "hubspot:1.0.0", "javascript_openai_ai_integrations:2.0.0", "github:1.0.0", "stripe:1.0.0"]

[userenv]

[userenv.production]
PRODUCTION_URL = "https://observatory-synozur-prod.replit.app"

[userenv.shared]
TEST_EMAIL = "test@synozur.com"
TEST_PASSWORD = "TestPass123!"
GNEWS_API_KEY = "e16dd44feb054d697453232587729ac7"
STRIPE_PRO_PRICE_ID = "price_1TSygKAoFb2Twt95RtWn8M0b"
STRIPE_PRO_ANNUAL_PRICE_ID = "price_1TSygKAoFb2Twt95Z7ftUFp6"
LINKEDIN_MCP_URL = "https://mcp.mcpbundles.com/bundle/linkedin"
LINKEDIN_DIRECT_PUBLISH_ENABLED = "true"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[objectStorage]
defaultBucketID = "replit-objstore-7732f445-e623-487e-959c-af350317396c"
